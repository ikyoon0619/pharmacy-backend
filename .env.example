# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 깃에 올리지 않는다.
KAKAO_REST_API_KEY=
SPRING_PROFILES_ACTIVE=demo
# AI 자연어 검색 (비워 두면 AI 검색만 꺼진다)
ANTHROPIC_API_KEY=
# 선택: 모델, 하루 한도 (기본값 claude-opus-5-5 / 50 / 5)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=50
# AI_PER_CLIENT_DAILY_LIMIT=5
# local 프로필(MariaDB)에서만 필요
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
# 약국 영업시간 (공공데이터포털 일반 인증키 Decoding). 비워 두면 영업시간 기능만 꺼진다.
DATA_GO_KR_SERVICE_KEY=
